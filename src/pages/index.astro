---
import '../styles/global.css';
import icon from '../ico.png';
import LocalMap from '../components/LocalMap.astro';
import FilterPreview from '../components/FilterPreview.astro';
import WaterJourney from '../components/WaterJourney.astro';

const questions = [
  { question: '¿En dónde ofrecen atención?', answer: 'AquaFiltro tiene su sede en la Zona Metropolitana de Guadalajara. La disponibilidad de instalación y cobertura se confirma al solicitar una cotización.' },
  { question: '¿El panel muestra datos de un equipo real?', answer: 'No. Esta página presenta una demostración visual con datos ficticios. La aplicación, los sensores y las notificaciones reales todavía no están conectados.' },
  { question: '¿Qué sistema necesita mi hogar?', answer: 'La selección depende del origen y las características del agua, del consumo y del espacio de instalación. Es necesario evaluar estos puntos antes de recomendar un equipo.' },
  { question: '¿Cómo sé cuándo cambiar los filtros?', answer: 'Los intervalos dependen del equipo, su uso y las condiciones del agua. La propuesta de aplicación contempla recordatorios; los plazos y sensores se definirán con el hardware final.' },
];
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Conoce AquaFiltro: sistemas de filtración de agua para tu hogar en Guadalajara y una propuesta de monitoreo inteligente. Explora nuestra demostración." />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href={icon.src} />
    <title>AquaFiltro — Agua que cuidas. Tranquilidad que sientes.</title>
    <script is:inline>
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch {}
      function applyTheme(dark) {
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#14241f' : '#FFFFFF';
        const toggle = document.getElementById('theme-toggle');
        if (toggle) toggle.setAttribute('aria-pressed', String(dark));
      }
      applyTheme(savedTheme === 'dark' || (savedTheme !== 'light' && systemTheme.matches));
      systemTheme.addEventListener('change', (event) => {
        if (savedTheme !== 'light' && savedTheme !== 'dark') applyTheme(event.matches);
      });
      document.addEventListener('DOMContentLoaded', () => {
        applyTheme(document.documentElement.dataset.theme === 'dark');
        document.getElementById('theme-toggle').addEventListener('click', () => {
          savedTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          applyTheme(savedTheme === 'dark');
          try { localStorage.setItem('theme', savedTheme); } catch {}
        });
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="header wrap">
      <a class="brand" href="#" aria-label="AquaFiltro, inicio"><img src={icon.src} width="38" height="42" alt="" />Aqua<span>Filtro</span><span class="brand-dot">®</span></a>
      <nav aria-label="Navegación principal">
        <a href="#sistema">El sistema</a><a href="#monitoreo">Monitoreo</a><a href="#preguntas">Preguntas</a>
      </nav>
      <div class="header-actions"><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Modo oscuro" aria-pressed="false"><span class="moon-icon" aria-hidden="true">☾</span><span class="sun-icon" aria-hidden="true">☀</span></button><a class="button button-small" href="#contacto">Hablemos de tu agua <span aria-hidden="true">↗</span></a></div>
    </header>

    <main id="contenido">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="tiny-dot"></span> AGUA, TECNOLOGÍA Y TRANQUILIDAD</p>
          <h1 id="hero-title">Un cambio que<br />fluye hacia<br /><em>algo mejor.</em></h1>
          <p class="intro">Un sistema de filtración para tu hogar. Una nueva forma de conocer el agua que te acompaña todos los días.</p>
          <div class="hero-actions"><a class="button" href="#contacto">Encuentra tu AquaFiltro <span aria-hidden="true">↗</span></a><a class="text-link" href="#monitoreo">Explorar el monitoreo <span aria-hidden="true">→</span></a></div>
          <div class="local-note"><span aria-hidden="true">⌖</span><span>Desde Guadalajara, para tu hogar.<br /><small>Atención en la Zona Metropolitana</small></span></div>
        </div>
        <div class="hero-visual" aria-label="Previsualización conceptual del sistema de filtración">
          <div class="visual-top"><span><span class="tiny-dot"></span> DISEÑADO PARA TU DÍA A DÍA</span><span>AF / 01</span></div>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <FilterPreview />
          <div class="visual-tags"><span class="visual-tag tag-one"><span class="tiny-dot"></span> Agua + innovación</span>
          <span class="visual-tag tag-two">Pensado para tu hogar <span aria-hidden="true">↗</span></span></div>
          <div class="visual-bottom"><div><p class="eyebrow">VISTA CONCEPTUAL</p><p>Explora el filtro y sus sensores propuestos.</p></div><span class="outline-pill">Diseño no definitivo</span></div>
        </div>
      </section>

      <div class="benefit-strip"><div class="wrap strip-inner"><span>Una mejor relación con tu agua.</span><span><i>↗</i> Filtración para el hogar</span><span><i>◎</i> Monitoreo propuesto</span><span><i>⌖</i> Atención local</span></div></div>

      <section id="sistema" class="section wrap">
        <div class="section-heading"><div><p class="eyebrow">01 / EL SISTEMA</p><h2>Simple por fuera.<br /><em>Bien pensado por dentro.</em></h2></div><p>De la entrada de agua a la información en tu pantalla. Conoce la idea detrás de AquaFiltro.</p></div>
        <WaterJourney />
      </section>

      <section id="monitoreo" class="monitor-section">
        <div class="wrap monitor-grid">
          <div class="monitor-copy"><p class="eyebrow">02 / CONECTA CON TU AGUA</p><h2>Menos dudas.<br /><em>Más claridad.</em></h2><p>Así podría verse tu sistema desde la aplicación. La información importante, en un solo lugar y sin complicaciones.</p><ul class="feature-list"><li><span>◎</span><div><h3>Un vistazo al funcionamiento</h3><p>Consulta las lecturas y el estado del equipo.</p></div></li><li><span>◷</span><div><h3>Mantenimiento a la vista</h3><p>Una referencia visual para planificar el cuidado.</p></div></li><li><span>↗</span><div><h3>Información donde estés</h3><p>Una experiencia pensada para tu teléfono.</p></div></li></ul><p class="disclaimer">Vista conceptual. Sin conexión a sensores ni notificaciones reales. Las mediciones no certifican la potabilidad del agua.</p></div>
          <div class="dashboard"><div class="dashboard-heading"><div class="mini-brand"><img src={icon.src} width="28" height="31" alt="" />Mi AquaFiltro</div><span class="demo-badge">DEMO VISUAL</span></div><div class="dashboard-greeting"><span>ASÍ SE VERÍA TU PANEL</span><h3>Hola, qué bueno verte.</h3><p>Un vistazo al agua de tu hogar.</p></div><div class="system-status"><div><span class="tiny-dot"></span> Sistema en funcionamiento</div><span>Ejemplo</span></div><div class="metrics"><div class="metric"><span>Flujo de agua <span aria-hidden="true">↗</span></span><p>2.4 <small>L/min</small></p><span class="metric-foot">Lectura ilustrativa</span><svg viewBox="0 0 220 46" role="img" aria-label="Gráfica ilustrativa del flujo"><path d="M0 35 18 29 34 32 50 19 69 23 84 12 103 20 120 13 141 17 161 7 181 12 200 5 220 9" /></svg></div><div class="metric"><span>Temperatura <span aria-hidden="true">◦</span></span><p>22 <small>°C</small></p><span class="metric-foot">Lectura ilustrativa</span><div class="temperature-track"><span></span></div></div></div><div class="filter-status"><div><span>Cuidado del filtro</span><strong>72% <small>vida útil estimada</small></strong></div><div class="progress" role="img" aria-label="Vida útil ficticia del filtro: 72 por ciento"><span></span></div><p>Estimación de ejemplo, no calculada por sensores.</p></div><div class="dashboard-footer"><span class="tiny-dot"></span> Todos los valores son ficticios <span aria-hidden="true">⌁</span></div></div>
        </div>
      </section>

      <section class="local-section wrap"><LocalMap /><div><p class="eyebrow">03 / CERCA DE TI</p><h2>Tecnología cercana.<br /><em>Atención de aquí.</em></h2><p>Somos AquaFiltro, en la Zona Metropolitana de Guadalajara. Queremos ayudarte a encontrar una solución que tenga sentido para tu hogar.</p><div class="local-steps"><span><b>01</b> Conocemos tu necesidad</span><span><b>02</b> Evaluamos tu instalación</span><span><b>03</b> Te orientamos sobre tu sistema</span></div></div></section>

      <section id="preguntas" class="faq-section wrap"><div><p class="eyebrow">LO QUE QUIERES SABER</p><h2>Todo más<br /><em>claro.</em></h2></div><div class="faqs">{questions.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>

      <section id="contacto" class="contact-section wrap"><div class="contact-card"><p class="eyebrow">EL SIGUIENTE PASO EMPIEZA CONTIGO</p><h2>Hagamos que algo<br /><em>bueno fluya en tu hogar.</em></h2><p>Atención en la Zona Metropolitana de Guadalajara.</p><div class="contact-pending"><span class="tiny-dot"></span> Canal de cotización próximamente</div><p class="contact-note">Estamos preparando nuestro contacto comercial. Este sitio aún no recibe solicitudes ni realiza ventas.</p></div></section>
    </main>
    <footer class="wrap footer"><a class="brand" href="#"><img src={icon.src} width="30" height="33" alt="" />Aqua<span>Filtro</span></a><p>Agua que cuidas. Tranquilidad que sientes.</p><span>© {new Date().getFullYear()} AquaFiltro</span></footer>
    <a class="back-to-top" href="#" aria-label="Volver arriba" title="Volver arriba"><span aria-hidden="true">↑</span></a>
  </body>
</html>
